// Feature: inventory

enum StockMovementReason {
  SCAN_USE
  SCAN_ADD
  BOUGHT
  MANUAL_CORRECTION
  /// Used while cooking a meal (recipes feature); undoing a tap adds a correcting COOKED movement.
  COOKED
}

/// How much of a product is at one place (pantry in the kitchen, screws in the garage).
model StockItem {
  id          String          @id @default(cuid())
  householdId String
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  placeId     String
  place       Place           @relation(fields: [placeId], references: [id], onDelete: Cascade)
  quantity    Decimal         @default(0) @db.Decimal(12, 3)
  /// Overrides the product's unit when set.
  unit        String?
  /// Stock at or below this goes on the shopping list (LOW_STOCK) for its default shop.
  minQuantity Decimal?        @db.Decimal(12, 3)
  /// Earliest expiry date of what is here.
  expiresOn   DateTime?       @db.Date
  movements   StockMovement[]
  lastCountedAt DateTime?
  /// Skip physical counts for this location until its quantity next reaches zero.
  countExcludedUntilEmpty Boolean @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([productId, placeId])
  @@index([householdId])
  @@index([placeId])
  @@map("stock_items")
}

/// Every change to a stock quantity, with who did it and why.
model StockMovement {
  stockPurchaseId String?
  stockPurchase StockPurchase? @relation(fields: [stockPurchaseId], references: [id], onDelete: SetNull)
  id             String              @id @default(cuid())
  householdId    String
  household      Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  stockItemId    String
  stockItem      StockItem           @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  delta          Decimal             @db.Decimal(12, 3)
  /// Quantity after the change.
  quantityAfter  Decimal             @db.Decimal(12, 3)
  reason         StockMovementReason
  /// Soft reference to the user (no relation, the auth schema stays untouched).
  userId         String?
  /// The shopping item that was bought, for BOUGHT movements.
  shoppingItemId String?
  /// Soft reference to the meal being cooked, for COOKED movements (recipes feature).
  mealPlanEntryId String?
  /// The chat receipt image this purchase was recorded from, if any.
  assistantImageId String?
  assistantImage   AssistantImage?      @relation(fields: [assistantImageId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime            @default(now())

  @@index([stockItemId, createdAt])
  @@index([mealPlanEntryId])
  @@index([assistantImageId])
  @@map("stock_movements")
}

/// One actual acquisition, independent of scans, shopping ticks and receipt evidence.
/// Soft product/place/shop references preserve its identity after catalogue/list changes.
model StockPurchase {
  /// Deliberate purpose shares; these neither consume nor reserve stock and never book a payment.
  allocationRevision Int @default(0)
  allocationHouseholdQuantity Decimal? @db.Decimal(12, 3)
  projectAllocations PurchaseProjectAllocation[]
  /// Actual selected variant, independently of the canonical stock product and mutable visit item.
  purchasedProductId String?
  purchasedProductName String?
  /// Quantity/unit the person actually selected; stock quantity can use a different known unit.
  purchasedQuantity Decimal? @db.Decimal(12, 3)
  purchasedUnit String?
  shoppingPurchaseId String?
  shoppingPurchase ShoppingPurchase? @relation(fields: [shoppingPurchaseId], references: [id], onDelete: SetNull)
  sessionItemId String?
  sessionItem ShoppingSessionItem? @relation(fields: [sessionItemId], references: [id], onDelete: SetNull)
  movements StockMovement[]
  id             String @id @default(cuid())
  householdId    String
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  stockItemId    String
  productId      String
  shopId         String?
  shopConfirmed  Boolean @default(false)
  quantity       Decimal @db.Decimal(12, 3)
  unit           String?
  purchasedAt    DateTime
  stockAdded     Boolean
  shoppingItemId String?
  userId         String
  createdAt      DateTime @default(now())

  @@index([householdId, productId, purchasedAt])
  @@index([householdId, shoppingItemId])
  @@map("stock_purchases")
}

/// Stable source identities make retries and uploading the same receipt idempotent.
model StockPurchaseEvidence {
  id          String @id @default(cuid())
  householdId String
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sourceKey   String
  purchaseIds String[]
  stockItemId String
  quantity    Decimal @db.Decimal(12, 3)
  createdAt   DateTime @default(now())

  @@unique([householdId, sourceKey])
  @@index([householdId])
  @@map("stock_purchase_evidence")
}

/// Purpose of already acquired goods, independently of expense cost shares and actual consumption.
model PurchaseProjectAllocation {
  id String @id @default(cuid())
  purchaseId String
  purchase StockPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName String
  quantity Decimal @db.Decimal(12, 3)
  @@unique([purchaseId, projectId])
  @@index([projectId])
  @@map("purchase_project_allocations")
}
