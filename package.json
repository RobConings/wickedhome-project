{
  "name": "wickedhome",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env --clear-screen=false src/api/server.ts",
    "build": "prisma generate && vite build && node scripts/build-server.mjs",
    "start": "node --env-file=.env --enable-source-maps dist/server.js",
    "deploy": "npm run build && pm2 restart wickedhome --update-env",
    "job": "tsx --env-file=.env src/api/jobs/run-job.ts",
    "typecheck": "tsc",
    "test": "DATABASE_URL=${DATABASE_URL:-postgresql://test@localhost/test} tsx --test $(find src ai -name '*.test.ts' -not -path '*/generated/*')",
    "assistant:eval": "tsx ai/eval/run-eval.ts",
    "lint": "eslint .",
    "storybook": "storybook dev --port 6006 --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build --output-dir dist/storybook",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio --port 5555 --browser none",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "barcode-detector": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "croner": "^9.1.0",
    "express": "^5.2.1",
    "i18next": "^26.4.2",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.50.0",
    "pdfjs-dist": "~5.6.205",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "~7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "uqr": "^0.1.3",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "prisma": "7.10.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
